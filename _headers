# ============================================================
# GV INGENIERÍA — _headers (Netlify)
# F8: Security headers — Content Security Policy, HSTS, etc.
# KAHIO Studio · Landing Pro · Fases F1–F12
# ============================================================

/*
  # F8 — Previene clickjacking
  X-Frame-Options: DENY

  # F8 — Previene MIME sniffing
  X-Content-Type-Options: nosniff

  # F8 — Referrer Policy
  Referrer-Policy: strict-origin-when-cross-origin

  # F8 — Permissions Policy (deshabilita APIs innecesarias)
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

  # F8 — HSTS: fuerza HTTPS por 1 año
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # F8 — Content Security Policy
  # Ajustá los dominios permitidos según tus recursos externos reales.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://formspree.io https://www.google-analytics.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://formspree.io;

  # F8 — XSS Protection legacy (IE)
  X-XSS-Protection: 1; mode=block

# Cache para assets estáticos
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Sin cache para HTML
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

# Sin cache para webmanifest
/site.webmanifest
  Cache-Control: no-cache
